# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acd_db?schema=public"

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Tên hiển thị trong ứng dụng xác thực 2 lớp
TWO_FACTOR_ISSUER="ACD Architecture"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"

# OAuth - Facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/oauth/facebook/callback"

# SMS - Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# SMS - Webhook tùy chỉnh (thay thế Twilio)
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""

# Email - Resend
RESEND_API_KEY=""
MAIL_FROM="ACD Architecture <no-reply@acd-arc.com>"

# Email - SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="ACD Architecture"

# Storage Settings
STORAGE_DRIVER="local"
UPLOAD_DIR="./public/uploads"
PRIVATE_FILES_DIR="./storage/private"

# Digital Download Policy
DOWNLOAD_TOKEN_EXPIRATION_HOURS=72
DOWNLOAD_TOKEN_MAX_COUNT=5
GOOGLE_SERVICE_ACCOUNT_EMAIL=
