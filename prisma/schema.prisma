generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String?          @unique
  passwordHash     String?
  role             UserRole         @default(USER)
  avatar           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  address          String?
  dateOfBirth      DateTime?
  emailVerified    DateTime?
  firstName        String?
  gender           String?
  lastName         String?
  phone            String?          @unique
  phoneVerified    DateTime?
  provider         String?          @default("local")
  providerId       String?
  twoFactorEnabled Boolean          @default(false)
  twoFactorSecret  String?
  twoFactorType    String?
  accounts         Account[]
  cartEvents       CartEvent[]
  downloadLinks    DownloadLink[]
  orders           Order[]
  pageViews        PageView[]
  posts            Post[]
  sessions         Session[]
  verifications    Verification[]
  visitSessions    VisitorSession[]
}

/// Phiên truy cập của khách (kể cả khách ẩn danh). Dùng cho thống kê CMS.
model VisitorSession {
  id          String      @id @default(cuid())
  visitorId   String      @unique
  userId      String?
  ip          String?
  userAgent   String?
  device      String?
  browser     String?
  os          String?
  referrer    String?
  landingPath String?
  lastPath    String?
  pageViews   Int         @default(0)
  durationSec Int         @default(0)
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  cartEvents  CartEvent[]
  visits      PageView[]
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([lastSeenAt])
  @@index([firstSeenAt])
}

/// Một lần xem trang, kèm thời gian khách ở lại trang
model PageView {
  id          String         @id @default(cuid())
  sessionId   String
  userId      String?
  path        String
  referrer    String?
  durationSec Int            @default(0)
  createdAt   DateTime       @default(now())
  session     VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}

/// Khách hàng đã cho sản phẩm vào giỏ / bỏ khỏi giỏ
model CartEvent {
  id          String          @id @default(cuid())
  sessionId   String?
  userId      String?
  productId   String?
  productName String
  productSlug String?
  price       Float           @default(0)
  action      String          @default("add")
  createdAt   DateTime        @default(now())
  session     VisitorSession? @relation(fields: [sessionId], references: [id])
  user        User?           @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([productId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Mã xác minh dùng một lần: đăng ký qua SĐT, quên mật khẩu, 2FA
model Verification {
  id         String    @id @default(cuid())
  identifier String
  code       String
  purpose    String
  channel    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model ProjectCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  shortDesc    String?
  description  String?
  location     String?
  client       String?
  year         Int?
  area         Float?
  style        String?
  buildingType String?
  isFeatured   Boolean          @default(false)
  categoryId   String?
  coverId      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  category     ProjectCategory? @relation(fields: [categoryId], references: [id])
  cover        Media?           @relation("ProjectCover", fields: [coverId], references: [id])
  gallery      ProjectMedia[]   @relation("ProjectGallery")
  tags         ProjectTag[]
}

model Media {
  id            String         @id @default(cuid())
  filename      String
  originalName  String?
  mimeType      String         @default("image/jpeg")
  size          Int            @default(0)
  url           String
  storageKey    String
  folder        String         @default("general")
  width         Int?
  height        Int?
  alt           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectCovers Project[]      @relation("ProjectCover")
  projectMedia  ProjectMedia[]
}

model ProjectMedia {
  id        String   @id @default(cuid())
  projectId String?
  mediaId   String
  sortOrder Int      @default(0)
  productId String?
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  product   Product? @relation("ProductGallery", fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation("ProjectGallery", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, productId, mediaId])
  @@index([projectId, sortOrder])
  @@index([productId, sortOrder])
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  posts     PostTag[]
  products  ProductTag[]
  projects  ProjectTag[]
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model Product {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  description            String?
  price                  Float?
  fileFormat             String?
  fileSize               String?
  fileKey                String?
  thumbnail              String?
  active                 Boolean        @default(true)
  featured               Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  downloadExpiresMinutes Int            @default(5)
  downloadLinkUrl        String?
  fileName               String?
  buildingArea           Float?
  floors                 Int?
  basementFloors         Int?
  totalFloorArea         Float?
  client                 String?
  landArea               Float?
  location               String?
  productCategory        String?
  shortDesc              String?
  style                  String?
  year                   Int?
  productGroup           String?
  discount               Float?
  priceAfterDiscount     Float?
  downloadLinks          DownloadLink[]
  orderItems             OrderItem[]
  tags                   ProductTag[]
  gallery                ProjectMedia[] @relation("ProductGallery")
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Order {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  userId        String?
  customerName  String
  customerEmail String
  customerPhone String?
  status        OrderStatus    @default(PENDING)
  total         Float
  paymentMethod String         @default("BANK_TRANSFER")
  paymentNote   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  downloads     DownloadLink[]
  user          User?          @relation(fields: [userId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  price       Float
  quantity    Int     @default(1)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model DownloadLink {
  id            String   @id @default(cuid())
  token         String   @unique
  orderId       String
  productId     String
  userId        String?
  expiresAt     DateTime
  maxDownloads  Int      @default(5)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])
}

model Post {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  excerpt   String?
  content   String
  coverUrl  String?
  published Boolean   @default(true)
  views     Int       @default(0)
  authorId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  author    User?     @relation(fields: [authorId], references: [id])
  tags      PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model SystemSetting {
  key       String   @id
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ProductType {
  CAD
  MODEL_3D
  INTERIOR
  TEMPLATE
  DOCUMENT
  OTHER
  ARCHITECTURE
  CONSTRUCTION
  DIGITAL_FILE
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}
